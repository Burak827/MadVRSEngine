{
  "AllowedHosts": "*",
  "DatabaseProvider": "Postgres",
  "ConnectionStrings": {
    "VendorDatabase": "Host=localhost;Port=5432;Database=vendorrisk;Username=postgres;Password=postgres"
  },
  "Data": {
    "RiskMatrixPath": "Data/RiskFactorMatrix.json",
    "SeedPath": "Data/SampleVendorData.json",
    "RulesPath": "Data/RiskRules.json"
  },
  "Cache": {
    "UseRedis": false,
    "RedisConnection": "localhost:6379",
    "TtlSeconds": 300
  },
  "ElasticConfiguration": {
    "Uri": ""
  },
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": "Debug",
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ],
    "Enrich": [ "FromLogContext", "WithMachineName", "WithThreadId" ]
  }
}
